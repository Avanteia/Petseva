# --- Database ---
# DB_EMBEDDED=true boots a zero-config PostgreSQL inside ./apps/api/.pgdata (no Docker needed).
# Set to false to use your own Postgres / docker-compose (see root docker-compose.yml).
DB_EMBEDDED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rms?schema=public

# --- Redis (optional). Leave empty to use the in-process event bus / queue. ---
REDIS_URL=

# --- Auth ---
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Printing ---
# Network printers are configured per outlet in the DB. This flag makes /print endpoints return
# the ESC/POS bytes + a text preview instead of opening a TCP socket (useful when no printer is attached).
PRINT_DRY_RUN=true

# --- AI provider (insights narration, anomaly explanations, pricing suggestions) ---
# mock (default) = deterministic, offline, template-based text — no network call, no key needed.
# anthropic = real Claude narration on top of the same pre-computed numbers. Needs ANTHROPIC_API_KEY.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
