{
  "name": "@rms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "node scripts/with-db.js nest start --watch",
    "start": "node scripts/with-db.js node dist/main.js",
    "db:start": "node scripts/with-db.js --hold",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/with-db.js tsx src/db/migrate.ts",
    "db:seed": "node scripts/with-db.js tsx src/db/seed.ts",
    "db:seed:history": "node scripts/with-db.js tsx src/db/seed-demo-history.ts",
    "db:reset": "node scripts/with-db.js tsx src/db/reset.ts",
    "db:studio": "node scripts/with-db.js drizzle-kit studio",
    "test": "jest",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.0",
    "@rms/shared": "*",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "embedded-postgres": "17.10.0-beta.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
